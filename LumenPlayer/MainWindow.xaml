<Window x:Class="LumenPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Lumen Player" Width="1200" Height="720" MinWidth="640" MinHeight="400"
        Icon="Assets/lumen.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown" StateChanged="Window_StateChanged" Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="ThumbPrev" Description="Previous" Click="Prev_Click" />
                <ThumbButtonInfo x:Name="ThumbPlay" Description="Play" Click="PlayPause_Click" />
                <ThumbButtonInfo x:Name="ThumbNext" Description="Next" Click="Next_Click" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Grid x:Name="TitleBar" Height="38" Background="{StaticResource Bg}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource CaptionButton}" Width="44" Content="&#xE700;" FontSize="14"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Menu" Click="Menu_Click" />
                <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource AccentGradient}" Margin="2,0,10,0">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" />
                </Border>
                <TextBlock x:Name="TitleText" Text="Lumen Player" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="700" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" FontSize="13" ToolTip="Settings (Ctrl+P)" Click="Settings_Click" />
                <Button x:Name="PinButton" Style="{StaticResource CaptionButton}" Content="&#xE718;" FontSize="13" ToolTip="Always on top (Ctrl+T)" Click="Pin_Click" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ============ Video + overlay ============ -->
            <vlc:VideoView x:Name="VideoView" Background="Black">
                <!-- Hosted in its own window by VideoView, so text styling must be set here rather than inherited. -->
                <Grid x:Name="OverlayRoot" Background="#01000000" AllowDrop="True" Focusable="True" FocusVisualStyle="{x:Null}"
                      TextElement.Foreground="{StaticResource TextPrimary}" TextElement.FontFamily="{StaticResource UiFont}"
                      Loaded="OverlayRoot_Loaded" SizeChanged="OverlayRoot_SizeChanged"
                      MouseMove="Overlay_MouseMove" MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                      MouseRightButtonUp="Overlay_MouseRightButtonUp" MouseWheel="Overlay_MouseWheel"
                      Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnPreviewKeyDown">

                    <!-- Welcome / idle screen -->
                    <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                        <Border Width="92" Height="92" CornerRadius="28" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="50" ShadowDepth="0" Opacity="0.65" />
                            </Border.Effect>
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="38" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" />
                        </Border>
                        <TextBlock Text="Lumen Player" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,6" />
                        <TextBlock Text="Drop videos, music, folders or subtitles anywhere. Plays virtually every format."
                                   Foreground="{StaticResource TextSecondary}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Click="OpenFile_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open file" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Click="OpenUrl_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open link" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="RecentSection" Margin="0,34,0,0">
                            <Grid Margin="12,0,12,6">
                                <TextBlock Text="RECENT" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="Clear" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" Cursor="Hand"
                                           MouseLeftButtonUp="ClearRecent_Click" />
                            </Grid>
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ListRowButton}" Tag="{Binding Path}" Click="Recent_Click" ToolTip="{Binding Path}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Folder}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                           Margin="16,0,0,0" MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Audio-only artwork -->
                    <StackPanel x:Name="AudioPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,90">
                        <Border Width="220" Height="220" CornerRadius="24" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="60" ShadowDepth="0" Opacity="0.5" />
                            </Border.Effect>
                            <Grid>
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="80" Foreground="#E6FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="AudioTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,4"
                                   TextTrimming="CharacterEllipsis" MaxWidth="600" />
                        <TextBlock x:Name="AudioArtist" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="600" />
                    </StackPanel>

                    <!-- Fullscreen top bar -->
                    <Grid x:Name="TopBar" VerticalAlignment="Top" Height="80" Visibility="Collapsed" IsHitTestVisible="False">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#B3000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <TextBlock x:Name="TopTitle" FontSize="16" FontWeight="SemiBold" Margin="24,18,200,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ClockText" FontSize="16" Margin="0,18,24,0" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" />
                    </Grid>

                    <!-- On-screen display -->
                    <Border x:Name="Osd" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24,24,24,0" Padding="16,9"
                            CornerRadius="10" Background="#C4121419" BorderBrush="#22FFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="OsdText" FontSize="15" FontWeight="SemiBold" />
                    </Border>

                    <!-- Play/pause pulse -->
                    <Border x:Name="FlashIcon" Width="88" Height="88" CornerRadius="44" Background="#99000000" Opacity="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                        <TextBlock x:Name="FlashGlyph" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Effects / adjustments flyout -->
                    <Border x:Name="EffectsPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,124" Width="420"
                            Background="{StaticResource Flyout}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16"
                            Padding="18,14,18,18" Visibility="Collapsed" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Adjustments &amp; effects" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Width="30" Height="30"
                                        HorizontalAlignment="Right" Click="CloseEffects_Click" />
                            </Grid>
                            <Border Background="#12FFFFFF" CornerRadius="10" Padding="3" Margin="0,12,0,14" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabVideo" Style="{StaticResource TabPill}" GroupName="fx" Content="Video" IsChecked="True" Checked="FxTab_Checked" />
                                    <RadioButton x:Name="TabEq" Style="{StaticResource TabPill}" GroupName="fx" Content="Equalizer" Checked="FxTab_Checked" />
                                    <RadioButton x:Name="TabSync" Style="{StaticResource TabPill}" GroupName="fx" Content="Sync &amp; speed" Checked="FxTab_Checked" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="VideoTab">
                                <CheckBox x:Name="AdjustEnable" Style="{StaticResource ToggleSwitch}" Content="Enable image adjustments" Margin="0,0,0,10"
                                          Checked="AdjustEnable_Changed" Unchecked="AdjustEnable_Changed" />
                                <StackPanel x:Name="VideoRows" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Reset" Padding="14,7" HorizontalAlignment="Right" Margin="0,8,0,0" Click="ResetAdjust_Click" />
                            </StackPanel>

                            <StackPanel x:Name="EqTab" Visibility="Collapsed">
                                <Grid Margin="0,0,0,12">
                                    <CheckBox x:Name="EqEnable" Style="{StaticResource ToggleSwitch}" Content="Enable equalizer"
                                              Checked="EqEnable_Changed" Unchecked="EqEnable_Changed" />
                                    <Button x:Name="EqPresetButton" Style="{StaticResource SecondaryButton}" Padding="12,6" HorizontalAlignment="Right" Click="EqPreset_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="EqPresetText" Text="Flat" />
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid x:Name="EqBands" Height="200" />
                            </StackPanel>

                            <StackPanel x:Name="SyncTab" Visibility="Collapsed">
                                <StackPanel x:Name="SyncRows" />
                                <TextBlock Text="Tip: double-click any slider to reset it." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bottom transport controls -->
                    <Grid x:Name="ControlsPanel" VerticalAlignment="Bottom">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#8C000000" Offset="0.45" />
                                <GradientStop Color="#E0000000" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <StackPanel Margin="18,52,18,12">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimeText" Text="0:00" Style="{StaticResource TimeLabel}" MinWidth="58" TextAlignment="Right" />
                                <Grid Grid.Column="1" Margin="14,0">
                                    <Slider x:Name="SeekSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="1"
                                            MouseMove="Seek_MouseMove" MouseLeave="Seek_MouseLeave" />
                                    <Canvas IsHitTestVisible="False">
                                        <Border x:Name="MarkerA" Width="2" Height="14" Canvas.Top="4" Background="{StaticResource Accent}" Visibility="Collapsed" />
                                        <Border x:Name="MarkerB" Width="2" Height="14" Canvas.Top="4" Background="{StaticResource Accent}" Visibility="Collapsed" />
                                        <Border x:Name="SeekTip" Canvas.Top="-34" Background="#F21C1F28" BorderBrush="#22FFFFFF" BorderThickness="1"
                                                CornerRadius="7" Padding="9,4" Visibility="Collapsed">
                                            <TextBlock x:Name="SeekTipText" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Canvas>
                                </Grid>
                                <TextBlock x:Name="LengthText" Grid.Column="2" Text="0:00" Style="{StaticResource TimeLabel}" MinWidth="58"
                                           Cursor="Hand" ToolTip="Click to toggle remaining time" MouseLeftButtonUp="LengthText_Click" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous (P)" Click="Prev_Click" />
                                    <Button x:Name="RewindBtn" Style="{StaticResource IconButton}" Content="&#xEB9E;" ToolTip="Back 10 s (Ctrl+←)" Click="Rewind_Click" />
                                    <Button x:Name="PlayPauseBtn" Style="{StaticResource PlayButton}" Content="&#xE768;" Margin="4,0" ToolTip="Play / pause (Space)" Click="PlayPause_Click" />
                                    <Button x:Name="ForwardBtn" Style="{StaticResource IconButton}" Content="&#xEB9D;" ToolTip="Forward 10 s (Ctrl+→)" Click="Forward_Click" />
                                    <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next (N)" Click="Next_Click" />
                                    <Button x:Name="StopBtn" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Stop (S)" Click="Stop_Click" />
                                    <Border Width="1" Height="20" Background="#33FFFFFF" Margin="8,0" />
                                    <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Mute (M)" Click="Mute_Click" />
                                    <Slider x:Name="VolumeSlider" Style="{StaticResource ModernSlider}" Width="100" Minimum="0" Maximum="200" Value="80"
                                            VerticalAlignment="Center" ValueChanged="Volume_ValueChanged" />
                                    <TextBlock x:Name="VolumeText" Text="80%" Style="{StaticResource TimeLabel}" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0" MinWidth="38" />
                                </StackPanel>

                                <TextBlock x:Name="NowPlayingText" Grid.Column="1" Foreground="{StaticResource TextSecondary}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" />

                                <StackPanel x:Name="RightButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="SpeedBtn" Style="{StaticResource TextChipButton}" Content="1×" ToolTip="Playback speed ([ / ])" Click="Speed_Click" />
                                    <Button x:Name="AbBtn" Style="{StaticResource TextChipButton}" Content="A-B" ToolTip="A-B loop (Shift+L)" Click="AbLoop_Click" />
                                    <Button x:Name="ShuffleBtn" Style="{StaticResource IconButton}" Content="&#xE8B1;" ToolTip="Shuffle (R)" Click="Shuffle_Click" />
                                    <Button x:Name="RepeatBtn" Style="{StaticResource IconButton}" Content="&#xE8EE;" ToolTip="Repeat (L)" Click="Repeat_Click" />
                                    <Button x:Name="AudioBtn" Style="{StaticResource IconButton}" Content="&#xE8D6;" ToolTip="Audio track &amp; device (B)" Click="AudioMenu_Click" />
                                    <Button x:Name="SubtitleBtn" Style="{StaticResource IconButton}" Content="&#xE7F0;" ToolTip="Subtitles (V)" Click="SubtitleMenu_Click" />
                                    <Button x:Name="VideoBtn" Style="{StaticResource IconButton}" Content="&#xE714;" ToolTip="Aspect, crop &amp; zoom (A)" Click="VideoMenu_Click" />
                                    <Button x:Name="EffectsBtn" Style="{StaticResource IconButton}" Content="&#xE9E9;" ToolTip="Adjustments &amp; effects (Ctrl+E)" Click="Effects_Click" />
                                    <Button x:Name="SnapshotBtn" Style="{StaticResource IconButton}" Content="&#xE722;" ToolTip="Snapshot (Shift+S)" Click="Snapshot_Click" />
                                    <Button x:Name="PlaylistBtn" Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="Playlist (Ctrl+L)" Click="TogglePlaylist_Click" />
                                    <Button x:Name="FullscreenBtn" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Fullscreen (F)" Click="Fullscreen_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </vlc:VideoView>

            <!-- ============ Playlist sidebar ============ -->
            <Border x:Name="Sidebar" Grid.Column="1" Width="330" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,8,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Playlist" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="PlaylistCount" Text="Empty" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="14" Width="34" Height="34" ToolTip="Add media" Click="PlaylistAdd_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74E;" FontSize="14" Width="34" Height="34" ToolTip="Save playlist" Click="SavePlaylist_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="14" Width="34" Height="34" ToolTip="Clear playlist" Click="ClearPlaylist_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Width="34" Height="34" ToolTip="Close" Click="TogglePlaylist_Click" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="PlaylistBox" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,0,0,8"
                             ItemContainerStyle="{StaticResource PlaylistItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Extended" MouseDoubleClick="PlaylistBox_MouseDoubleClick" KeyDown="PlaylistBox_KeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="PlaylistContext_Opened" />
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="title" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" Margin="10,0,4,0" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="glyph" Property="Text" Value="&#xE768;" />
                                        <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent}" />
                                        <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="title" Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="PlaylistEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="#44FFFFFF" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop files here" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
